@model Identity_Login.Models.ViewModels.RouterjobPdfVM

@{
    ViewData["Title"] = "Shipped Order Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg">
                <!-- ✅ CHANGED: Header color to bg-primary (blue) -->
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Shipped Order Details</h3>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Job Process</div>
                        <div class="col-sm-8">@Model.JobProcessName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Job Number</div>
                        <div class="col-sm-8">@Model.JobNumber</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Customer Name</div>
                        <div class="col-sm-8">@Model.CustomerName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Part Name</div>
                        <div class="col-sm-8">@Model.PartName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Drawing No</div>
                        <div class="col-sm-8">@Model.DrawingNo</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Date</div>
                        <div class="col-sm-8">@Model.Date?.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">PO/Verbal</div>
                        <div class="col-sm-8">@Model.VerbalNo</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Material</div>
                        <div class="col-sm-8">@Model.MaterailName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Quantity</div>
                        <div class="col-sm-8">@Model.Quantity</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Received By</div>
                        <div class="col-sm-8">@Model.RCVDBy</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Shipped By</div>
                        <div class="col-sm-8">@Model.ShippedBy</div>
                    </div>
                    <div class="row mb-2 run-type hideable">
                        <div class="col-sm-4 fw-bold">Run Type</div>
                        <div class="col-sm-8 text-danger fw-bold">@Model.RunTypeName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">ASF</div>
                        <div class="col-sm-8">@Model.ASFName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Classification</div>
                        <div class="col-sm-8">
                            <span>
                                @Model.ClassificationName
                            </span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Job Details</div>
                        <div class="col-sm-8">@Model.JobDetails</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Status</div>
                        <div class="col-sm-8">
                            <span class="badge bg-success">@Model.Status</span>
                        </div>
                    </div>

                    <!-- Images Row -->
                    <div class="row mb-4 mt-4 border-top pt-3">
                        <div class="col-sm-6 text-center">
                            <span class="fw-bold">QR Code</span><br />
                            @if (!string.IsNullOrEmpty(Model.QrCodeBase64))
                            {
                                <img src="@Url.Action("GetBlobImage", "RouterJobs", new { blobUrl = Model.QrCodeBase64 })"
                                     alt="QR"
                                     class="img-thumbnail"
                                     style="max-width: 120px; max-height: 120px;"
                                     onerror="this.style.display='none'" />
                            }
                            else
                            {
                                <span class="text-muted">No QR code generated</span>
                            }
                        </div>
                        <div class="col-sm-6 text-center">
                            <span class="fw-bold">Uploaded Images</span><br />
                            @if (Model.UploadImages != null && Model.UploadImages.Any())
                            {
                                <div class="d-flex flex-row flex-wrap justify-content-center" style="gap: 8px;">
                                    @foreach (var img in Model.UploadImages)
                                    {
                                        <img src="@Url.Action("GetBlobImage", "RouterJobs", new { blobUrl = img.ImagePath })"
                                             class="img-thumbnail"
                                             style="max-width:80px;max-height:80px;"
                                             alt="Job Image"
                                             onerror="this.style.display='none'" />
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No image uploaded</span>
                            }
                        </div>
                    </div>

                    <!-- ✅ CHANGED: Removed Edit button, only Back button -->
                    <div class="d-flex justify-content-start mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Shipped List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>