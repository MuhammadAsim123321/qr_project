@model EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Update User</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-3 row">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Role</label>
                            <select asp-for="Role" class="form-select" id="Role" name="Role">
                                <option disabled selected>Select Role</option>
                                @foreach (var item in Model.RoleList)
                                {
                                    <option value="@item.Value">
                                        @(item.Value == "Supervisor" ? "Staff" : item.Text)
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <div class="mb-3" id="stationDiv">
                            <label class="form-label fw-bold">Station Name</label>
                            <select asp-for="StationId" asp-items="Model.Stations" class="form-select">
                                <option value="">-- Select Station --</option>
                            </select>
                            <span asp-validation-for="StationId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Update
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            function toggleStationDiv() {
                var role = $("#Role").val();
                if (role === "Supervisor") {
                    $("#stationDiv").show();
                } else {
                    $("#stationDiv").hide();
                }
            }
            toggleStationDiv();
            $("#Role").change(function () {
                toggleStationDiv();
            });
        });
    </script>
}