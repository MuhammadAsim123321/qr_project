@model Identity_Login.Models.ViewModels.RouterJobEditVm

@{
    ViewData["Title"] = "Edit Router Job";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Edit Router Job</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data" method="post">
                        <input type="hidden" asp-for="JobId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerName" class="form-label fw-bold">Customer Name</label>
                                <input asp-for="CustomerName" class="form-control" id="customerInput" list="customerList" autocomplete="off" />
                                <datalist id="customerList"></datalist>
                                <span asp-validation-for="CustomerName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ProcessId" class="form-label fw-bold">Job Process</label>
                                <select asp-for="ProcessId" class="form-select" asp-items="ViewBag.JobProcessList">
                                    <option value="">-- Select Job Process --</option>
                                </select>
                                <span asp-validation-for="ProcessId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" type="checkbox" asp-for="DisappearAfterShipped" id="disappearSwitch">
                                    <label class="form-check-label fw-bold" for="disappearSwitch">
                                        Disappear after Shipped
                                    </label>
                                    <div class="form-text">If checked, this job will be hidden from the main list once status is 'Shipped'.</div>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="PartName" class="form-label fw-bold">Part Name</label>
                                <input asp-for="PartName" class="form-control" />
                                <span asp-validation-for="PartName" class="text-danger"></span>
                            </div>
                            <div class="mb-3 col-md-6">
                                <label class="form-label fw-bold">Upload Image</label>
                                <input type="file" name="ImageFiles" id="ImageFiles" class="form-control" accept="image/*" multiple />
                                <!-- Hidden field will hold final list of images (existing kept + new selected) -->
                                <input type="hidden" id="ExistingImages" name="ExistingImages" />
                                <div id="customFilePreview" class="mt-2 d-flex flex-wrap"></div>
                                <span id="placeholderText" class="text-muted">No files selected</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="DrawingNo" class="form-label fw-bold">Drawing No</label>
                                <input asp-for="DrawingNo" class="form-control" />
                                <span asp-validation-for="DrawingNo" class="text-danger"></span>
                            </div>
                            <div class="mb-3 col-md-6">
                                <label asp-for="Date" class="form-label fw-bold"></label>
                                <input asp-for="Date" class="form-control" type="date" />
                                <span asp-validation-for="Date" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="mb-3 col-md-6">
                                <label asp-for="VerbalNo" class="form-label fw-bold">Verbal No</label>
                                <input asp-for="VerbalNo" class="form-control" />
                                <span asp-validation-for="VerbalNo" class="text-danger"></span>
                            </div>
                            <div class="mb-3 col-md-6">
                                <label asp-for="MaterailId" class="form-label fw-bold">Material</label>
                                <select asp-for="MaterailId" class="form-select" asp-items="ViewBag.MaterailList">
                                    <option value="">-- Select Material --</option>
                                </select>
                                <span asp-validation-for="MaterailId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="mb-3 col-md-4">
                                <label asp-for="Quantity" class="form-label fw-bold"></label>
                                <input asp-for="Quantity" class="form-control" type="number" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>
                            <div class="mb-3 col-md-4">
                                <label asp-for="RCVDBy" class="form-label fw-bold">Received  By</label>
                                <input asp-for="RCVDBy" class="form-control" />
                                <span asp-validation-for="RCVDBy" class="text-danger"></span>
                            </div>
                            <div class="mb-3 col-md-4">
                                <label asp-for="ShippedBy" class="form-label fw-bold">Shipped By</label>
                                <input asp-for="ShippedBy" class="form-control" />
                                <span asp-validation-for="ShippedBy" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="mb-3 col-md-4 run-type hideable">
                                <label asp-for="RunTypeId" class="form-label fw-bold">Run Type</label>
                                <select asp-for="RunTypeId" class="form-select" asp-items="ViewBag.RunTypeList">
                                    <option value="">-- Select Run Type --</option>
                                </select>
                                <span asp-validation-for="RunTypeId" class="text-danger"></span>
                            </div>

                            <div class="mb-3 col-md-4 surface-area hideable">
                                <label asp-for="SurfaceArea" class="form-label fw-bold">Surface Area (IN²)</label>
                                <input asp-for="SurfaceArea" class="form-control" type="number" />
                                <span asp-validation-for="SurfaceArea" class="text-danger"></span>
                            </div>


                            <div class="mb-3 col-md-4 total-in2 hideable">
                                <label asp-for="TotalIn2OfRunRight" class="form-label fw-bold">TOTAL IN² of Run:</label>
                                <input asp-for="TotalIn2OfRunRight" class="form-control" type="number" step="any" id="TotalIn2OfRunRight" value="@Model.TotalIn2OfRunRight" />

                                <span asp-validation-for="TotalIn2OfRunRight" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="mb-3 col-md-6">
                                <label asp-for="ASFId" class="form-label fw-bold">ASF</label>
                                <select asp-for="ASFId" class="form-select" asp-items="ViewBag.ASFList" id="ASFId">
                                    <option value="">-- Select ASF --</option>
                                </select>
                                <span asp-validation-for="ASFId" class="text-danger"></span>
                            </div>
                            <div class="mb-3 col-md-6">
                                <label asp-for="ClassificationId" class="form-label fw-bold">Classification</label>
                                <select asp-for="ClassificationId" class="form-select" id="ClassificationId">
                                    <option value="">-- Select Classification --</option>
                                    @foreach (var item in ViewBag.ClassificationListWithMinutes)
                                    {
                                        <option value="@item.ClassificationId" data-minutes="@item.Minutes">
                                            @item.Name
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="ClassificationId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="mb-3 col-md-3  amps hideable">
                                <label class="form-label fw-bold">AMPS</label>
                                <input class="form-control" type="number" step="any" id="AMPS" value="@Model.AMPS" disabled style="background-color: #fff;" />
                            </div>
                            <div class="mb-3 col-md-3 amps-per-part hideable">
                                <label class="form-label fw-bold">AMPS Per Part</label>
                                <input class="form-control" type="number" step="any" id="AMPSPerParts" value="@Model.AMPSPerParts" disabled style="background-color: #fff;" />
                            </div>
                            <div class="mb-3 col-md-3">
                                <label class="form-label fw-bold">Time (Minutes)</label>
                                <input class="form-control" type="number" id="TimeMinutes" value="@Model.TimeMinutes" disabled style="background-color: #fff;" />
                            </div>
                            <div class="mb-3 col-md-3">
                                <label class="form-label fw-bold">Time (Seconds)</label>
                                <input class="form-control" type="number" id="TimeSeconds" value="@Model.TimeSeconds" disabled style="background-color: #fff;" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="JobDetails" class="form-label fw-bold">Job Description</label>
                                <textarea asp-for="JobDetails" class="form-control" rows="6"></textarea>
                                <span asp-validation-for="JobDetails" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Update
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateClassificationDropdown(setSelectedFromModel) {
            var asfId = $('#ASFId').val();
            var processId = $('#ProcessId').val();
            var $classification = $('#ClassificationId');
            $classification.empty();
            $classification.append($('<option>', { value: '', text: '-- Select Classification --' }));

            $.getJSON('@Url.Action("GetClassifications", "RouterJobs")', { asfId: asfId, processId: processId }, function (data) {
                $.each(data, function (i, item) {
                    $classification.append($('<option>', {
                        value: item.classificationId,
                        text: item.name,
                        'data-minutes': item.minutes
                    }));
                });

                // Always set the selected value from the model if requested
                if (setSelectedFromModel) {
                    var selected = '@Model.ClassificationId';
                    if (selected && selected !== "0") {
                        $classification.val(selected);
                    }
                } else {
                    $classification.val('');
                }

                // ✅ CRITICAL FIX: Call calculation AFTER dropdown is fully populated
                updateCalculatedFields();
            });
        }

        $(document).ready(function () {
            // On page load, set selected value from model
            updateClassificationDropdown(true);

            // On ASF/Process change, reset to placeholder
            $('#ASFId').change(function () { updateClassificationDropdown(false); });
            $('#ProcessId').change(function () { updateClassificationDropdown(false); });
        });
    </script>

    <script>
        $(document).ready(function () {
            let manualOverride = false;

            function updateTotalIn2OfRunRight() {
                if (manualOverride) return;
                var qty = parseFloat($('#Quantity').val()) || 0;
                var area = parseFloat($('#SurfaceArea').val()) || 0;

                if(qty && area) {
                    $('#TotalIn2OfRunRight').val((qty * area).toFixed(2));
                }
            }

            $('#TotalIn2OfRunRight').on('input', function () {
                manualOverride = true;
            });

            $('#Quantity, #SurfaceArea').on('input', function () {
                manualOverride = false;
                updateTotalIn2OfRunRight();
            });
        });
    </script>

    <script>
        function updateCalculatedFields() {
            var qty = parseFloat($('#Quantity').val()) || 0;
            var area = parseFloat($('#SurfaceArea').val()) || 0;
            var asfId = $('#ASFId').val();
            var asfText = $('#ASFId option:selected').text().trim();
            var totalIn2 = parseFloat($('#TotalIn2OfRunRight').val()) || (qty * area);
            var selectedProcess = $('#ProcessId option:selected').text();
            var classificationId = $('#ClassificationId').val();
            var classificationText = $('#ClassificationId option:selected').text().trim();
            var baseMinutes = parseInt($('#ClassificationId option:selected').data('minutes')) || 0;
            var isAsf8 = asfId === '1' || asfText.toLowerCase().includes('8 asf') || asfText.toLowerCase().startsWith('8');
            var isType2Class1Clear = classificationId === '2' || classificationText === "Type II, Class 1 (CLEAR)";
            var minutes = baseMinutes;

            if (isAsf8 && isType2Class1Clear) {
                minutes = 27;
            } else if (selectedProcess.includes("Black Oxide Process")) {
                minutes = 15;
            }

            // For 8 ASF (ASFId = 1), use division by 18; otherwise use standard formula
            if (asfId === '1' || asfText.toLowerCase().includes('8 asf') || asfText.toLowerCase().startsWith('8')) {
                $('#AMPS').val((totalIn2 / 18.0).toFixed(2));
                $('#AMPSPerParts').val((area / 18.0).toFixed(2));
            } else {
                var asfConstant = asfText.includes('16') ? (1.0/9.0) : (1.0/12.0);
                $('#AMPS').val((totalIn2 * asfConstant).toFixed(2));
                $('#AMPSPerParts').val((area * asfConstant).toFixed(2));
            }

            $('#TimeMinutes').val(minutes);
            $('#TimeSeconds').val(minutes * 60);
        }

        $(document).ready(function () {
            $('#Quantity, #SurfaceArea, #ASFId, #ClassificationId, #TotalIn2OfRunRight').on('input change', updateCalculatedFields);
        });
    </script>
    @* This script is handling the Material 2024 to show only for Chemical Conversion and Anodizing Process *@
    <script>
                $(document).on('change', '#ProcessId', function () {
            let proc = $(this).find('option:selected').text();
            let isSpec = proc.includes("Anodizing") || proc.includes("Chemical Conversion");
            $("#MaterailId option[value='7']").toggle(isSpec);
            if (!isSpec && $("#MaterailId").val() == "7") $("#MaterailId").val("");
        });
    </script>

    <script>
        $(function () {

            let keptExisting = [];      // IDs of images you keep
            let newFiles = [];          // new selected files

            // Render thumbnail (existing or new)
            function renderThumb(src, id, isExisting, fileObj) {
                const wrapper = $('<div>', { class: 'position-relative me-2 mb-2 d-inline-block' });

                const img = $('<img>', {
                    src: src,
                    class: 'img-thumbnail',
                    css: { height: '40px', width: 'auto' }
                });

                const btn = $('<button>', {
                    type: 'button',
                    text: '×',
                          class: 'btn btn-danger position-absolute top-0 end-0',
        css: {
            height: '20px',
            width: '20px',
            padding: '0',
            fontSize: '14px',
            lineHeight: '20px',
            textAlign: 'center'
        },
                    click: function () {

                        wrapper.remove();

                        if (isExisting) {
                            keptExisting = keptExisting.filter(x => x !== id);
                        } else {
                            newFiles = newFiles.filter(f => f !== fileObj);
                        }

                        updateHidden();

                        if ($("#customFilePreview").children().length === 0) {
                            $("#placeholderText").show();
                        }
                    }
                });

                return wrapper.append(img).append(btn);
            }

            // Update hidden field with IDs of kept existing images
            function updateHidden() {
                $("#ExistingImages").val(keptExisting.join(","));
            }

            // Load existing images for the job
            function loadImages(jobId) {
                const $preview = $("#customFilePreview");
                $preview.empty();

                $.getJSON('@Url.Action("GetImages", "RouterJobs")', { jobId }, function (data) {

                    if (!data || data.length === 0) {
                        $("#placeholderText").show();
                        return;
                    }

                    $("#placeholderText").hide();

                    keptExisting = data.map(x => x.uploadImageId);
                    updateHidden();

                    data.forEach(item => {
                        $preview.append(renderThumb(item.imagePath, item.uploadImageId, true, null));
                    });
                });
            }

            // Load existing on page load
            const jobId = '@Model.JobId';
            if (jobId) loadImages(jobId);

            // Handle selecting new images
            $("#ImageFiles").on("change", function (e) {
                const selected = Array.from(e.target.files);
                if (selected.length === 0) return;

                $("#placeholderText").hide();

                selected.forEach(file => {
                    newFiles.push(file);
                    const url = URL.createObjectURL(file);
                    $("#customFilePreview").append(renderThumb(url, null, false, file));
                });

                // IMPORTANT: Clear the file input NOW so it doesn't overwrite selections next time
                this.value = "";
            });

            // FINAL FIX — rebuild actual file input before form submit
            $("form").on("submit", function () {

                updateHidden();

                const dt = new DataTransfer();

                // Add all NEW files to DataTransfer
                newFiles.forEach(f => dt.items.add(f));

                // Replace real file input
                document.getElementById("ImageFiles").files = dt.files;
            });

        });
    </script>




    <script>
        // hide/show AMPS fields based on Job Process
        function toggleAmpsFields() {
            var selectedText = $('#ProcessId option:selected').text();
            var hideList = [
                "Passivation Process (Method 1)",
                "Passivation Process (Method 2)",
                "Black Oxide Process",
                "Chemical Conversion"
            ];

            if (hideList.includes(selectedText)) {
                $('#AMPS').closest('.col-md-3').hide();
                $('#AMPSPerParts').closest('.col-md-3').hide();
            } else {
                $('#AMPS').closest('.col-md-3').show();
                $('#AMPSPerParts').closest('.col-md-3').show();
            }
        }

        $('#ProcessId').change(toggleAmpsFields);
        toggleAmpsFields(); // initial call
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const processSelect = document.getElementById("ProcessId");

            function toggleFields() {
                const selectedText = processSelect.options[processSelect.selectedIndex]?.text || "";

                // Reset: show all
                document.querySelectorAll(".hideable").forEach(el => el.style.display = "");

                if (selectedText.includes("Passivation Process (Method 1)") || selectedText.includes("Passivation Process (Method 2)")) {
                    document.querySelectorAll(".run-type, .surface-area, .total-in2, .amps, .amps-per-part").forEach(el => el.style.display = "none");
                }
                else if (selectedText.includes("Chemical Conversion")) {
                    document.querySelectorAll(".amps, .amps-per-part").forEach(el => el.style.display = "none");
                }
                else if (selectedText.includes("Black Oxide Process")) {
                    document.querySelectorAll(".run-type, .surface-area, .total-in2, .amps, .amps-per-part").forEach(el => el.style.display = "none");
                }
            }

            processSelect.addEventListener("change", toggleFields);
            toggleFields();
        });
    </script>

    @* This functipon is calling the suggestion Name list for customer  *@
    <script>
        $(document).ready(function () {
            let timeout = null;

            $('#customerInput').on('input', function () {
                clearTimeout(timeout);
                let term = $(this).val();

                // Only search if user has typed at least 1 character
                if (term.length < 1) {
                    $('#customerList').empty();
                    return;
                }

                // Debounce: Wait 300ms after the user stops typing to call the server
                timeout = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("GetCustomerSuggestions", "RouterJobs")',
                        type: 'GET',
                        data: { term: term },
                        success: function (data) {
                            let $datalist = $('#customerList');
                            $datalist.empty(); // Clear old suggestions

                            $.each(data, function (i, name) {
                                $datalist.append($('<option>').val(name));
                            });
                        },
                        error: function (err) {
                            console.error("Error fetching suggestions:", err);
                        }
                    });
                }, 300);
            });
        });</script>


    <script>
        $(document).ready(function () {
            function updateTimeLogic() {
                var asfId = $('#ASFId').val();
                var asfText = $('#ASFId option:selected').text().trim();
                var classificationId = $('#ClassificationId').val();
                var classificationText = $('#ClassificationId option:selected').text().trim();
                var selectedProcess = $('#ProcessId option:selected').text();

                // Get base minutes from data attribute
                var baseMinutes = parseInt($('#ClassificationId option:selected').data('minutes')) || 0;
                var finalMinutes = baseMinutes;
                var isAsf8 = asfId === '1' || asfText.toLowerCase().includes('8 asf') || asfText.toLowerCase().startsWith('8');
                var isType2Class1Clear = classificationId === '2' || classificationText === "Type II, Class 1 (CLEAR)";

                // Apply specific logic: If ASF contains "8" and Classification is "Type II, Class 1 (CLEAR)"
                if (isAsf8 && isType2Class1Clear) {
                    finalMinutes = 27;
                }
                // Keep your existing override for Black Oxide
                else if (selectedProcess.includes("Black Oxide Process")) {
                    finalMinutes = 15;
                }

                $('#TimeMinutes').val(finalMinutes);
                $('#TimeSeconds').val(finalMinutes * 60);
            }

            // Bind to the dropdowns that trigger the logic
            $('#ASFId, #ClassificationId, #ProcessId').on('change', updateTimeLogic);

            // Run on load
            updateTimeLogic();
        });
    </script>




}