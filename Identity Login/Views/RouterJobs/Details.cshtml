@model Identity_Login.Models.ViewModels.RouterjobPdfVM

@{
    ViewData["Title"] = "Router Job Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Router Job Details</h3>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Job Process</div>
                        <div class="col-sm-8">@Model.JobProcessName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Job Number</div>
                        <div class="col-sm-8">@Model.JobNumber</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Customer Name</div>
                        <div class="col-sm-8">@Model.CustomerName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Part Name</div>
                        <div class="col-sm-8">@Model.PartName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Drawing No</div>
                        <div class="col-sm-8">@Model.DrawingNo</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Date</div>
                        <div class="col-sm-8">@Model.Date?.ToString("yyyy-MM-dd")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">PO/Verbal</div>
                        <div class="col-sm-8">@Model.VerbalNo</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Material</div>
                        <div class="col-sm-8">@Model.MaterailName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Quantity</div>
                        <div class="col-sm-8">@Model.Quantity</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Received By</div>
                        <div class="col-sm-8">@Model.RCVDBy</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Shipped By</div>
                        <div class="col-sm-8">@Model.ShippedBy</div>
                    </div>
                    <div class="row mb-2 run-type hideable">
                        <div class="col-sm-4 fw-bold">Run Type</div>
                        <div class="col-sm-8 text-danger fw-bold">@Model.RunTypeName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Parts</div>
                        <div class="col-sm-8">PICK-UP</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">ASF</div>
                        <div class="col-sm-8">@Model.ASFName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Classification</div>
                        <div class="col-sm-8">
                            <span>
                                @Model.ClassificationName
                            </span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Job Details</div>
                        <div class="col-sm-8">@Model.JobDetails</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 fw-bold">Status</div>
                        <div class="col-sm-8">@Model.Status</div>
                    </div>
                    <!-- Images Row -->
                    <div class="row mb-4">
                        <div class="col-sm-6 text-center">
                            <span class="fw-bold">QR Code</span><br />
                            @if (!string.IsNullOrEmpty(Model.QrCodeBase64))
                            {
                                <img src="@Model.QrCodeBase64" alt="QR" class="img-thumbnail" style="max-width: 120px; max-height: 120px;" />
                            }
                            else
                            {
                                <span class="text-muted">No QR code generated</span>
                            }
                        </div>
                        <div class="col-sm-6 text-center">
                            <span class="fw-bold">Uploaded Images</span><br />
                            @if (Model.UploadImages != null && Model.UploadImages.Any())
                            {
                                <div class="d-flex flex-row flex-wrap justify-content-center" style="gap: 8px;">
                                    @foreach (var img in Model.UploadImages)
                                    {
                                        <img src="@img.ImagePath" class="img-thumbnail" style="max-width:80px;max-height:80px;" />
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">No image uploaded</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.JobId" class="btn btn-primary">
                            <i class="bi bi-pencil-square"></i> Update
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const processName = "@Model.JobProcessName";

            // Reset: show all
            document.querySelectorAll(".hideable").forEach(el => el.style.display = "");

            if (processName.includes("Passivation Process (Method 1)") || processName.includes("Passivation Process (Method 2)")) {
                document.querySelectorAll(".run-type, .surface-area, .total-in2, .amps, .amps-per-part").forEach(el => el.style.display = "none");
            }
            else if (processName.includes("Chemical Conversion")) {
                document.querySelectorAll(".amps, .amps-per-part").forEach(el => el.style.display = "none");
            }
            else if (processName.includes("Black Oxide Process")) {
                document.querySelectorAll(".run-type, .surface-area, .total-in2, .amps, .amps-per-part").forEach(el => el.style.display = "none");
            }
        });
    </script>
}
