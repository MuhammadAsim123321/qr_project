<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Material Management</h4>
                    <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
                        <i class="bi bi-plus-circle"></i> Add New Material
                    </button>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" id="materialSearch" class="form-control border-start-0" placeholder="Search Materials...">
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Material Name</th>
                                    <th class="text-end" style="width: 120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="materialTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addMaterialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5>Add Material Type</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="text" id="addMaterialName" class="form-control" placeholder="Enter material name...">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="submitAddMaterial()">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editMaterialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5>Edit Material</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="editMaterialId">
                <input type="text" id="editMaterialName" class="form-control">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="submitEditMaterial()">Update</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteMaterialModal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content border-0">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalTitle">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="materialConfirmView">
                    <p class="fs-5 mt-3">Are you sure you want to delete <br><strong id="deleteMaterialNameDisp" class="text-danger"></strong>?</p>
                </div>

                <div id="materialErrorView" style="display:none;">
                    <div class="alert alert-danger border-0">
                        <i class="bi bi-exclamation-triangle-fill fs-1 d-block mb-2"></i>
                        <h5 class="fw-bold">Deletion Restricted</h5>
                        <p id="materialErrorMessage" class="mb-0"></p>
                    </div>
                </div>

                <input type="hidden" id="deleteMaterialId">
            </div>
            <div class="modal-footer justify-content-center pb-4 border-0">
                <div id="materialConfirmButtons">
                    <button type="button" class="btn btn-outline-secondary px-4 me-2" data-bs-dismiss="modal">No, Cancel</button>
                    <button type="button" class="btn btn-danger px-4" onclick="submitDeleteMaterial()">Yes, Delete</button>
                </div>
                <div id="materialErrorButtons" style="display:none;">
                    <button type="button" class="btn btn-secondary px-5" data-bs-dismiss="modal">I Understand</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadMaterialTypes();

            $("#materialSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#materialTableBody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });

        function loadMaterialTypes() {
            $.get('/MaterialType/GetAllMaterialTypes', function (data) {
                let rows = '';
                if (data.length === 0) {
                    rows = '<tr><td colspan="2" class="text-center text-muted">No materials found.</td></tr>';
                } else {
                    data.forEach(item => {
                        rows += `
                        <tr>
                            <td class="fw-bold text-dark">${item.name}</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info me-1" onclick="openEditModal(${item.materailId}, '${item.name}')">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="openDeleteModal(${item.materailId}, '${item.name}')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>`;
                    });
                }
                $('#materialTableBody').html(rows);
            });
        }

        function submitAddMaterial() {
            let name = $('#addMaterialName').val().trim();
            if(!name) return;
            $.post('/MaterialType/CreateMaterialType', { name: name }, function(res) {
                if(res.success) {
                    $('#addMaterialModal').modal('hide');
                    $('#addMaterialName').val('');
                    loadMaterialTypes();
                }
            });
        }

        function openEditModal(id, name) {
            $('#editMaterialId').val(id);
            $('#editMaterialName').val(name);
            $('#editMaterialModal').modal('show');
        }

        function submitEditMaterial() {
            let id = $('#editMaterialId').val();
            let name = $('#editMaterialName').val().trim();
            if(!name) return;
            $.post('/MaterialType/EditMaterialType', { id: id, newName: name }, function(res) {
                if(res.success) {
                    $('#editMaterialModal').modal('hide');
                    loadMaterialTypes();
                }
            });
        }

        // OPEN DELETE MODAL (RESET STATE)
        function openDeleteModal(id, name) {
            $('#deleteMaterialId').val(id);
            $('#deleteMaterialNameDisp').text(name);

            // Show Confirmation, Hide Error
            $('#materialConfirmView, #materialConfirmButtons').show();
            $('#materialErrorView, #materialErrorButtons').hide();
            $('#deleteModalTitle').text("Confirm Delete");

            $('#deleteMaterialModal').modal('show');
        }

        // SUBMIT DELETE WITH IN-MODAL ERROR HANDLING
        function submitDeleteMaterial() {
            let id = $('#deleteMaterialId').val();

            $.ajax({
                url: '/MaterialType/DeleteMaterialType',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if(res.success) {
                        $('#deleteMaterialModal').modal('hide');
                        loadMaterialTypes();
                    } else {
                        // Switch modal to Error View
                        $('#materialErrorMessage').text(res.message);
                        $('#materialConfirmView, #materialConfirmButtons').hide();
                        $('#materialErrorView, #materialErrorButtons').show();
                        $('#deleteModalTitle').text("Action Blocked");
                    }
                },
                error: function() {
                    alert("A server error occurred while deleting.");
                }
            });
        }
    </script>
}